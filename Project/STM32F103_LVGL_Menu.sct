; *************************************************************
; STM32F103C8T6 链接脚本 (64KB Flash / 20KB RAM)
; *************************************************************
LR_IROM1 0x08000000 0x00020000  {    ; Flash
  ER_IROM1 0x08000000 0x00020000  {
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00005000  {   ; SRAM
   .ANY (+RW +ZI)
  }
}
